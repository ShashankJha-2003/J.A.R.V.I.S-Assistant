# ==============================================================================
# J.A.R.V.I.S. AI Voice Control Assistant — Full Advanced Stack Configuration
# Copy to `.env` and set any optional cloud/local keys you want to activate.
# Works immediately out-of-the-box with ZERO API keys (Offline + Hybrid Mode)!
# ==============================================================================

# --- Assistant Identity ---
JARVIS_ASSISTANT_NAME=J.A.R.V.I.S.
JARVIS_USER_NAME=Sir
JARVIS_WAKE_WORDS=jarvis,hey jarvis,ok jarvis,hey nova

# --- A. Orchestration Runtime ---
# Options: custom_asyncio | pipecat | livekit
JARVIS_ORCHESTRATOR=custom_asyncio

# --- B. Speech-to-Text (STT) + Wake Word + VAD ---
# STT options: auto | faster_whisper | vosk | deepgram | assemblyai | groq_whisper | openai_whisper | google
JARVIS_STT_ENGINE=auto
JARVIS_WHISPER_MODEL=base.en
JARVIS_VOSK_MODEL_PATH=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
JARVIS_LANGUAGE=en-US

# Wake Word & VAD (Optional: pvporcupine & silero-vad)
PICOVOICE_ACCESS_KEY=
JARVIS_VAD_ENGINE=auto

# --- C. AI Brain / LLM + Function Calling ---
# Options: auto | gemini | openai | groq | ollama | offline
JARVIS_LLM_PROVIDER=auto
JARVIS_FAST_PATH_ROUTING=true

GEMINI_API_KEY=
JARVIS_GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
JARVIS_OPENAI_MODEL=gpt-4o-mini
JARVIS_OPENAI_BASE_URL=https://api.openai.com/v1

GROQ_API_KEY=
JARVIS_GROQ_MODEL=llama-3.3-70b-versatile

JARVIS_OLLAMA_URL=http://localhost:11434
JARVIS_OLLAMA_MODEL=llama3.2

# --- D. Text-to-Speech (TTS — Expressive Cloud & Fast Offline) ---
# TTS options: auto | edge | elevenlabs | cartesia | piper | kokoro | pyttsx3 | none
JARVIS_TTS_ENGINE=auto
JARVIS_EDGE_TTS_VOICE=en-GB-RyanNeural
ELEVENLABS_API_KEY=
JARVIS_ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
CARTESIA_API_KEY=
JARVIS_CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091
JARVIS_PIPER_MODEL_PATH=
JARVIS_KOKORO_VOICE=bm_george
JARVIS_TTS_RATE=185
JARVIS_TTS_VOLUME=1.0
JARVIS_SPEAK_RESPONSES=true

# Microphone / VAD Tuning
JARVIS_MIC_ENERGY_THRESHOLD=0.015
JARVIS_SILENCE_DURATION=1.3
JARVIS_MAX_LISTEN_SECONDS=12.0

# --- E. Safety Allowlist & Laptop Control ---
JARVIS_REQUIRE_CONFIRMATION=true
JARVIS_STRICT_ALLOWLIST=true
JARVIS_DEFAULT_CITY=London

# --- Web HUD Server ---
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
JARVIS_AUTO_OPEN_BROWSER=true
JARVIS_DATA_DIR=data
JARVIS_KNOWLEDGE_DIR=knowledge
JARVIS_LOG_LEVEL=INFO

# Persona, Tone & Proactive Monitoring
JARVIS_PERSONA=calm
JARVIS_PROACTIVE_ALERTS=true
JARVIS_BATTERY_LOW_THRESHOLD=15

# Smart Home & IoT (Optional Home Assistant REST or MQTT Broker)
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883
